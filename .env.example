# Copy to .env and fill locally. NEVER commit .env.
# `python -m scripts.seed` adds FLOWTOOL_SECRET_KEY automatically.
APP_ENV=development
FLOWTOOL_SECRET_KEY=

# Amazon RDS PostgreSQL (leave unset to use local SQLite)
# FLOWTOOL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-DB.xxxxx.ap-south-1.rds.amazonaws.com:5432/powderflow?sslmode=require

# Razorpay (Dashboard > Account & Settings > API Keys / Webhooks).
# rzp_test_ keys = test mode, rzp_live_ keys = live payments. Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Sign-in email for the first superadmin account (keep it out of the repository)
FLOWTOOL_SUPERADMIN_EMAIL=

# Optional overrides
# FLOWTOOL_ALLOW_REGISTRATION=false
# FLOWTOOL_CORS_ORIGINS=https://your-frontend.example
# DATA_DIR=data/raw
# MODEL_DIR=models

# Cloud settings — provide via CI secrets / cloud identity, not in files
AWS_REGION=
AZURE_LOCATION=
