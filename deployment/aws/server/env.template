# /opt/flowlytix/.env on the EC2 server. Readable by root only. Never commit or share it.
APP_ENV=production
IMAGE_URI=__IMAGE_URI__
# ip = https://<elastic-ip>   sslip = https://<ip-with-dashes>.sslip.io (backup)
SITE_MODE=__SITE_MODE__
FLOWTOOL_SECRET_KEY=__GENERATED__

# Amazon RDS PostgreSQL. Leave empty to use SQLite on this server's disk.
# postgresql+psycopg://USER:PASSWORD@ENDPOINT:5432/flowlytix?sslmode=require
FLOWTOOL_DATABASE_URL=

# Private S3 bucket for profile and team photos (leave empty to keep them on this server)
FLOWTOOL_S3_BUCKET=
AWS_REGION=

# Sign-in email for the first superadmin account
FLOWTOOL_SUPERADMIN_EMAIL=

# Razorpay keys (rzp_live_ = real payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set to false to stop public sign-ups
FLOWTOOL_ALLOW_REGISTRATION=true
